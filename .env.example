# cursor2api — copy to .env (compose reads it) or use as a systemd EnvironmentFile.
# Everything here is optional; the defaults work for a local run.

# --- listener ---
CURSOR_DIRECT_HOST=127.0.0.1
CURSOR_DIRECT_PORT=8790

# Require callers to send `Authorization: Bearer <value>`.
# Set this before exposing the port beyond localhost.
# CURSOR_DIRECT_API_KEY=sk-your-secret

# --- accounts ---
# Written by `npm run login` / `npm run import-local`. Mode 0600.
CURSOR_DIRECT_AUTH_FILE=./accounts.json

# --- upstream ---
CURSOR_DIRECT_BASE_URL=https://api2.cursor.sh
# Bump when Cursor starts version-gating older clients.
CURSOR_DIRECT_CLIENT_VERSION=cli-2026.08.11-e8db854
CURSOR_DIRECT_TIMEOUT_MS=300000

# Send all upstream traffic (RPC + token refresh) through a SOCKS5 proxy.
# Do not wrap the process in nsproxy-style redirectors — see docs/.
# CURSOR_DIRECT_PROXY_URL=socks5://127.0.0.1:1080

# --- model naming ---
# Exposed as `cursor-<upstream id>`. Set empty for raw upstream ids. Ids that already
# start with the prefix (cursor-grok-*) are not doubled.
CURSOR_DIRECT_MODEL_PREFIX=cursor-
# Models whose effort suffix (-low/-medium/-high/-xhigh) follows the request's
# reasoning_effort. Comma-separated globs; `none` disables. Keep it narrow: gateways
# may send a default effort for callers that did not ask for one.
CURSOR_EFFORT_FROM_REQUEST_MODELS=grok-*

# --- tool surface ---
# Which of Cursor's native tools the model may see, as ToolCall oneof proto names.
# Keep this to the caller's MCP tools. Adding shell_tool_call, read_tool_call, or
# pi_*_tool_call shows the model Shell/Read/Grep and it stops using bash/read/edit.
# `get_mcp_tools_tool_call` is required. Use `*` to keep all natives.
CURSOR_ALLOWED_NATIVE_TOOLS=mcp_tool_call,get_mcp_tools_tool_call

# --- prompt mapping ---
# Cursor accepts no client system role, so `system` messages are delivered as the
# opening exchange of the conversation. false = send the system role verbatim
# (the upstream will ignore it).
CURSOR_DIRECT_SYSTEM_AS_HISTORY=true
# Used when a request ends on a tool result and carries no new user message.
CURSOR_DIRECT_CONTINUATION_PROMPT=Continue, using the tool results above.

CURSOR_DIRECT_LOG_REQUESTS=true
